rules_version = '2';

// Pravidla pro rezervace studia.
// Appka je bez hesla: číst a zapisovat může kdokoli s odkazem,
// ale do databáze projdou jen správně tvarované rezervace naší party.
// Když přidáte člověka, doplňte ho sem i do PEOPLE v index.html.
service cloud.firestore {
  match /databases/{database}/documents {

    function names() {
      return ['Herb', 'Olb', 'Žaludos', 'Beky'];
    }

    function validBooking(d) {
      return d.keys().hasOnly(['day', 'start', 'end', 'owner', 'type', 'members', 'guests', 'note', 'links'])
        && d.keys().hasAll(['day', 'start', 'end', 'owner', 'type', 'members'])
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is int && d.end is int
        && d.start >= 480 && d.end <= 1800 && d.end - d.start >= 30
        && d.owner in names()
        && d.type in ['open', 'private']
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 4
        && d.members.hasOnly(names()) && d.owner in d.members
        // hosté = lidi bez kanálu, jen jména (v appce šedí)
        && (!('guests' in d) || (d.guests is list && d.guests.size() <= 8))
        && (!('note' in d) || (d.note is string && d.note.size() <= 60))
        && (!('links' in d) || (d.links is list && d.links.size() <= 30));
    }

    // Spočítaný waveform souboru z Google Disku (id dokumentu = id souboru na Disku).
    // Počítá ho prohlížeč, který soubor uvidí první, ostatní si ho jen přečtou.
    function validWave(d) {
      return d.keys().hasOnly(['name', 'mime', 'size', 'sum', 'dur', 'ch', 'peak', 'rms', 'w', 'v', 'at'])
        && d.keys().hasAll(['name', 'dur', 'w', 'v'])
        && d.name is string && d.name.size() <= 200
        && d.dur is number && d.dur > 0 && d.dur <= 14400
        && d.w is string && d.w.size() <= 4000
        && d.v is int
        && (!('mime' in d) || (d.mime is string && d.mime.size() <= 100))
        && (!('sum' in d) || (d.sum is string && d.sum.size() <= 64))
        && (!('size' in d) || d.size is number)
        && (!('ch' in d) || (d.ch is int && d.ch >= 1 && d.ch <= 32))
        && (!('peak' in d) || d.peak is number)
        && (!('rms' in d) || d.rms is number)
        && (!('at' in d) || d.at is int);
    }

    // Vlastní kategorie odkazů (beat / track / jiné jsou pevně v index.html).
    // Dají se jen přidat, ne přepsat ani smazat, ať nikomu nezmizí kategorie u jeho odkazů.
    function validCat(d) {
      return d.keys().hasOnly(['name', 'color', 'by', 'at'])
        && d.keys().hasAll(['name', 'color', 'by'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.color is string && d.color.matches('^#[0-9a-f]{6}$')
        && d.by in names()
        && (!('at' in d) || d.at is int);
    }

    match /cats/{id} {
      allow read: if true;
      allow create: if id.matches('^k[a-z0-9]{3,16}$') && validCat(request.resource.data);
      allow update, delete: if false;
    }

    match /bookings/{id} {
      allow read: if true;
      allow create, update: if validBooking(request.resource.data);
      allow delete: if true;
    }

    match /waves/{id} {
      allow read: if true;
      allow create, update: if id.matches('^[A-Za-z0-9_-]{10,100}$') && validWave(request.resource.data);
      allow delete: if false;
    }

    // všechno ostatní zavřené
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
